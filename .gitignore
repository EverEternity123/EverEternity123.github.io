# ---------------------------------------------------------------------------
# 这个仓库 = 你的博客网站（GitHub Pages 从根目录发布）
# 下面这些是开发用的东西，不发布
# ---------------------------------------------------------------------------

# 本地工具（预览服务、自检脚本、截图脚本）
.tools/

# 本地助手的工作目录：里面有私人笔记，绝对不要提交
.workbuddy-ai/

# 本地预览截图
_preview/

# 每篇文章的分享静态页：由 .tools/build-posts.py 从 data/posts.json 生成，
# 是**产物**不是内容 —— 发布脚本会现生成再上传，所以不留在版本库里
# （留着的话每发一篇文章都要多出一堆 diff）。
p/

# 前台用的两份数据也是产物，由 .tools/build-index.py 从 data/posts.json 生成：
#   data/index.json  列表页要的元数据（不含正文）
#   data/c/<id>.json 单篇文章的正文
# 同样发布时现生成。**注意：data/posts.json 仍然是内容，必须提交**，
# 它才是写作台读写的唯一真源。
data/index.json
data/c/

# GitHub 令牌（用于 API 推送 / 手机编辑）。绝对不要提交！
.gh-token
.env
.env.local

# 系统文件
.DS_Store
Thumbs.db

# 依赖（本项目零依赖，正常不会有）
node_modules/

# ---------------------------------------------------------------------------
# 注意：下面这些是网站内容，必须提交
#   *.html   assets/（含 assets/img/post/ 里你插的图）   data/*.json
#   write.config.js
# write.config.js 里只有你的用户名和仓库名，不是密钥，可以公开
#
# 唯一「不提交但要发布」的是 p/ —— 它是从 data/posts.json 生成的产物，
# 发布脚本每次会现生成再上传（见上面那段说明）。
# ---------------------------------------------------------------------------
